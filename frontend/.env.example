# Copy to .env.local for development. Never commit real values.

# Where the FastAPI backend listens. Read on the server only: it is used by the
# /api rewrite in next.config.ts and by the route protection in src/proxy.ts.
# The browser never sees it; client code only calls relative /api/... URLs.
#
# The rewrite destination is fixed when the app is built, so set this before
# `npm run build` (and pass it as a build argument to the Docker image).
API_ORIGIN=http://127.0.0.1:8010
