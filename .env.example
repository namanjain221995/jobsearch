# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Leave blank for the defaults (gpt-6-astra / claude-opus-5-5). The OpenAI model must support the
# Responses API web_search tool; the Claude model must support the web search server tool.
OPENAI_MODEL=
ANTHROPIC_MODEL=
# PostgreSQL (primary database) and Redis (background search queue, login throttling).
# The defaults match `docker compose up -d postgres redis`.
DATABASE_URL=postgresql+asyncpg://jobfinder:jobfinder@127.0.0.1:55432/jobfinder
REDIS_URL=redis://127.0.0.1:56379/0
# Most results one candidate search may return (hard ceiling of the engine and of the search form). 1000 is the
# largest value the API accepts. An existing .env that still says 500 keeps every search at 500.
SEARCH_MAX_RESULTS=1000

# Where users reach the web app. Used in invitation and password-reset links and for the same-origin check.
PUBLIC_BASE_URL=http://127.0.0.1:3010
# APP_ENV=production            # production forces Secure cookies
# COOKIE_SECURE=true            # set when the site is served over HTTPS
# Only behind a reverse proxy (nginx, Caddy, a load balancer) that sets X-Forwarded-For itself. The web app passes a
# caller's own X-Forwarded-For through unchanged, so without such a proxy leave this off.
# TRUST_FORWARDED_FOR=true
# TRUSTED_PROXY_HOPS=1
# API_DOCS=true                 # /api/docs and /api/openapi.json; off by default in production
# MAX_ACTIVE_SEARCHES_PER_USER=3
# MAX_ACTIVE_SEARCHES=12
# ALLOWED_ORIGINS=              # extra origins allowed to send state-changing requests (comma separated)

# First administrator (read once by: python -m app.portal.bootstrap). Leave empty to be asked interactively.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrator

# E-mail for invitations and password resets. Without SMTP the app shows a link for the inviter to copy.
# The connection uses STARTTLS (port 465: TLS from the start) and the mail server's certificate is verified (chain and host name). A server
# without STARTTLS or with an untrusted certificate gets no password and no message; the send is reported as failed.
# For a mail server with a certificate from a private authority, point SSL_CERT_FILE at that authority's certificate.
# SMTP_STARTTLS=false sends the password and the links unencrypted: only for a relay on this same machine.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true
# SMTP_IMPLICIT_TLS=             # TLS from the first byte; switched on by itself when SMTP_PORT is 465
# EMAIL_BACKEND=                # "console" prints mails to the server log (development only)

# Sessions and sign-in
# SESSION_HOURS=12
# REMEMBER_DAYS=30
# INVITATION_HOURS=48
# PASSWORD_MIN_LENGTH=10
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_MINUTES=15

# Team searches
# MAX_MEMBERS_PER_SEARCH=10
# MAX_RESULTS_PER_SEARCH_RUN=500   # candidates x results per candidate in one run. Default of the Admin setting
#                                  # "results per search run" (Settings, up to 5000): set 1000 or more to allow a
#                                  # 1,000-job search for one candidate.
# MEMBER_SEARCH_CONCURRENCY=2
# WORKER_MAX_SEARCHES=2
# DEFAULT_MIN_MATCH_SCORE=50

# The pre-PostgreSQL index file (source of `python -m app.portal.migrate_sqlite`, and the legacy single-user app).
# LEGACY_SQLITE_PATH=./jobfinder.db

# Faster AI calls: none / low / medium / high (leave blank to send no setting)
# OPENAI_REASONING_EFFORT=low

# Optional extra source: Adzuna aggregator (free key from https://developer.adzuna.com). Not live-tested.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Local job index
# INDEX_TTL_SECONDS=3600          # a source is re-read when its copy is older than this
# PREWARM_ON_START=true           # read employer boards in the background at startup
# FETCH_DEADLINE_SECONDS=45       # longest a search waits for sources
# DISABLED_SOURCES=               # e.g. amazon,jobicy,remoteok,himalayas,workday,workable

# Headless browser crawler (needs: playwright install chromium)
# BROWSER_ENABLED=true
# BROWSER_CONCURRENCY=6
# MAX_BROWSER_PAGES_PER_SEARCH=24

# Page leads: postings on employers' own career sites (and on career platforms without a reader) are read from the page
# MAX_PAGE_VERIFICATIONS=400               # page leads read per ROUND of a search of 50 results (scales with the request; the whole
#                                          # search stops at MAX_PAGE_VERIFICATIONS_MAX). Every site is asked for two of its
#                                          # leads first; a site that refuses both (HTTP 401 / 403 / 429, robots.txt) is not asked again.
# LEAD_VERIFICATION_SECONDS=120            # time box of one round's lead check: board reads and one plain request per page lead
#                                          # first, the browser and the AI page check while time is left. Correct jobs come before
#                                          # speed, so it is generous; nothing is accepted because time ran out. 0 = no time box.
#                                          # A larger request gets up to twice as long (like the calls of its rounds).
# LEAD_VERIFICATION_BACKGROUND_SECONDS=90  # plain page requests still running at the time box may finish this long after it;
#                                          # what they verify is remembered (source career_page) and found by the next search
# PAGE_VERIFICATION_CONCURRENCY=32         # read at the same time; never more than two requests at a time per host
# MAX_CRAWL_LINKS_PER_SEARCH=48            # job links followed from careers and listing pages
# MAX_AI_PAGE_EXTRACTIONS=8                # pages in one AI page-check call (pages without structured job data)
# AI_PAGE_EXTRACTION_CALLS=10              # such calls per round when the company model answers them (no bill)
# AI_PAGE_EXTRACTION_PAID_CALLS=1          # of which OpenAI / Claude may answer this many (all there are without the company model)
# AI_PAGE_EXTRACTION_CONCURRENCY=4         # page-check calls running at the same time

# AI web search: what ONE ROUND of a search makes (request of 50 or fewer; a larger request up to twice as much a round).
# These are not budgets: every further round makes them again with new searches, until the requested number of verified
# matching jobs is reached, SEARCH_STALE_ROUNDS rounds in a row brought nothing new, or SEARCH_MAX_SECONDS is reached.
# Measured 2026-11-21 (three profiles): one round is about 170 to 180 web searches, 1.75 to 1.90 USD, and finishes in
# 45 to 60 s; a 25-job search usually needs one round. The `*_MAX` settings further down are safety ceilings only.
# OPENAI_SEARCH_CALLS=6                    # calls on the ATS hosts, each with its own `site:host "title" place` searches
# CLAUDE_SEARCH_CALLS=6
# AI_WEB_SEARCHES_PER_CALL=5               # searches of one call on ATS hosts
# OPENAI_OPEN_WEB_CALLS=3                  # calls on employers' OWN career sites (any domain), ON TOP of the calls above:
# CLAUDE_OPEN_WEB_CALLS=6                  # they never take from the ATS hosts. One kind of employer per call.
# AI_OPEN_WEB_SEARCHES_PER_CALL=10         # searches of one such call (one employer's career site each)
# AI_OPEN_WEB_FOLLOWUP_CALLS=3             # further open-web calls a round: when the first ones have returned, the career sites
#                                          # they found postings on (and the sites of remembered postings with a fitting title)
#                                          # are searched once more, held to exactly those sites
# OPEN_WEB_RECENCY_WORDS=true              # open-web searches for the requested title carry the current month and year
# AI web search (discovery), per provider. Every call gets its own `site:host "title" place` searches (no search is
# asked twice in one job search, by either provider), is restricted to the hosts the search can use (the ATS platform
# filter, readers that are switched on), and only addresses the search tool itself returned become leads.
# OPENAI_SEARCH_MODEL=gpt-6-luna           # model for web-search discovery only; empty = OPENAI_MODEL. The cheapest current
# ANTHROPIC_SEARCH_MODEL=claude-haiku-5-5  # model of each provider: measured 2026-11-21 on the same searches, the larger models
#                                          # verified no more postings (the addresses come from the search tool, not the model).
# OPENAI_SEARCH_CONCURRENCY=12             # web-search calls of one job search running at the same time
# CLAUDE_SEARCH_CONCURRENCY=12
# AI_DISCOVERY_STRAGGLER_SECONDS=20        # once three quarters of a round's calls have returned, the others get this long
# AI_DISCOVERY_CALL_TIMEOUT_SECONDS=100    # one web-search call; a call still running then is dropped, the others keep their leads
# AI_DISCOVERY_DEADLINE_SECONDS=120        # all web-search calls of one round together
# AI_DISCOVERY_BREAKER_FAILURES=2          # failed calls in a row that switch a provider off for the rest of that job search;
#                                          # the other provider takes over its searches (a wrong key or used-up quota: at once)
# AI_OPEN_WEB_SHARE=0.5                    # legacy switch. It used to divide the calls between the ATS hosts and employers'
#                                          # own sites; the open-web calls now have their own settings above. 0 still switches
#                                          # every open-web call and query off (AI, search engines, AWS); any other value = on.
#                                          # An open-web call blocks the ATS hosts the other calls search, job boards, and career
#                                          # platforms that may not be read. Under an ATS platform filter nothing looks at the open
#                                          # web. OpenAI's search tool does not hold a `site:` query to its site, so its open-web
#                                          # call is two requests: the model names the career sites, then the search is restricted
#                                          # to exactly those sites. AI_OPEN_WEB_SPLIT is no longer used.
# SEARCH_ENGINE_OPEN_WEB_QUERIES=12        # open-web queries (no `site:`) one search sends through SearXNG and TinyFish in the
#                                          # first round. Only an address that reads like ONE posting on an employer's own site
#                                          # becomes a lead (no job board, no list or search page, no host that is never fetched).
#                                          # The company model's web search is not used for these (its addresses are model text).
# MAX_AI_CALLS_PER_SEARCH=30
# MAX_AI_RANKED_JOBS=120
# MAX_BOARDS_PER_SEARCH=1500
# MAX_CONCURRENT_SEARCHES=2

# --- Wider searches: more real postings per search -------------------------------------------------------------
# Nothing here invents a posting: every result is still read from an employer board API or a verified page.
# Defaults suit a 4 GB server. "Larger machine" marks the ones worth raising when there is more memory / CPU.
#
# Company model service (OpenAI-compatible, no per-call bill, no web search). Empty key = not used: title expansion
# and page extraction go to OpenAI / Claude, and jobs beyond the AI-judged slice keep the keyword score.
TECHSARA_API_KEY=
# TECHSARA_BASE_URL=https://ai.techsarasolutions.com/v1
# TECHSARA_MODEL=techsara-35b              # chat: title expansion, page extraction, written explanations
# TECHSARA_RERANK_MODEL=techsara-rerank    # /v1/rerank: scores every candidate job against the profile (measured: about 18 jobs/s)
# TECHSARA_TIMEOUT_SECONDS=90
# TECHSARA_RETRIES=3                       # after 503 / 429 / timeout, honouring Retry-After (capped at 20 s); then the old path is used
# TECHSARA_CONCURRENCY=4                   # its queue is shared with the chat application
# TECHSARA_RERANK_BATCH=32
# TECHSARA_RERANK_MAX_JOBS=3000            # 3,000 jobs take about 3 minutes; larger machine: no need to raise, the limit is the model's speed
# TECHSARA_EXPLAIN_MAX_JOBS=400            # jobs beyond the OpenAI/Claude slice that get a written explanation
# TECHSARA_EXPLAIN_BATCH=5
# TECHSARA_EXPLAIN_SECONDS=180             # time one search may spend on those explanations
#
# Title expansion: one model call per search proposes real-world variants of the requested titles ("Data Engineer" ->
# "Analytics Engineer", "ETL Developer", ...). Validated, capped, cached. Cost: one small call (company model: none).
# TITLE_EXPANSION=true                     # false switches it off
# TITLE_EXPANSION_MAX=12
# TITLE_EXPANSION_CACHE_HOURS=168
#
# Search-engine discovery through a SearXNG instance (JSON API must be enabled in its settings). Empty = off.
# It finds employer job boards on Greenhouse, Lever, Ashby, Workable and Workday; each new board is then read
# through its own API, now and in every later search. No AI cost. Time: one query every
# SEARXNG_MIN_INTERVAL_SECONDS, so 72 queries (a 300-job request) take about 2.5 minutes spread over the rounds.
SEARXNG_URL=
# SEARXNG_TIMEOUT_SECONDS=12
# SEARXNG_MIN_INTERVAL_SECONDS=2           # lower only for an instance of your own with several engines behind it
# SEARXNG_CACHE_HOURS=12                   # the same query is not sent again for this long (kept in the index)
# SEARXNG_QUERIES_PER_SEARCH=12            # for a request of 50 or fewer; scales with the request ...
# SEARXNG_QUERIES_PER_SEARCH_MAX=90        # ... up to this ceiling
# SEARXNG_PAGES_PER_QUERY=2
# SEARXNG_NEW_BOARDS_PER_SEARCH=40         # for 50 or fewer; scales up to:
# SEARXNG_NEW_BOARDS_PER_SEARCH_MAX=400    # every new board is one API request now and one per index refresh from then on
# SEARXNG_PAGE_LEADS_PER_SEARCH=40
# SEARXNG_SITES=boards.greenhouse.io,job-boards.greenhouse.io,jobs.lever.co,jobs.ashbyhq.com,apply.workable.com,myworkdayjobs.com,jobs.smartrecruiters.com,recruitee.com,applytojob.com
#   (add pinpointhq.com with PINPOINT_ENABLED=true and ats.rippling.com with RIPPLING_ENABLED=true; a host whose reader is off only spends queries)
#
# Startup ATS board readers and Workable (docs/board-sources.md has the robots.txt and terms findings)
# RECRUITEE_ENABLED=true                   # documented Careers Site API, one request per employer board
# PINPOINT_ENABLED=false                   # off: most employer tenants answer robots.txt with Disallow: /
# RIPPLING_ENABLED=false                   # off until Rippling's terms are reviewed (undocumented endpoints, terms pages could not be read)
# WORKABLE_SEARCH_ENABLED=true             # Workable's cross-company job search (undocumented); false keeps only the documented account reader
#
# Imported board catalogue, read little by little in the background (boards per minute per ATS; 0 = not read)
# BOARD_CATALOG_TRICKLE=1
# BOARD_CATALOG_PER_MINUTE_RECRUITEE=15    # one read = robots.txt + one API call to that employer's own host; half of the 1 request/s platform pace
# BOARD_CATALOG_PER_MINUTE_WORKABLE=4      # all accounts are on one host (apply.workable.com)
# BOARD_CATALOG_PER_MINUTE_WORKDAY=2
# BOARD_CATALOG_REFRESH_HOURS=24           # a board with US postings is read again when this old
# BOARD_CATALOG_RECHECK_DAYS=7             # first re-check of a board without US postings; doubles with every further miss
# BOARD_CATALOG_RETRY_HOURS=6              # first retry after a failed read; doubles likewise
# BOARD_CATALOG_DEAD_DAYS=30               # first retry of a board that answered "not found"
# BOARD_CATALOG_MAX_BACKOFF_DAYS=90
#
# Career-site crawler (app/career_sites.py): an employer's own career site, once a search verified a posting on it or
# once it was imported (python -m app.portal.import_boards --career-sites FILE.csv; form: app/data/career_sites.example.csv),
# is read in the background for all its US postings: sitemaps first, then job data and links on the listing page, then
# the listing page in the headless browser. No ATS platform is involved, nothing runs during a search. It obeys
# robots.txt for every request, never logs in, submits or works around a robot check (such a site is left alone), and
# needs the worker's background reader (BOARD_CATALOG_TRICKLE=1, PREWARM_ON_START=true) and CAREER_PAGE_MEMORY=true.
# CAREER_SITE_CRAWL=true                   # false: sites are still remembered, none is crawled
# CAREER_SITE_CRAWL_DAYS=7                 # one site is crawled at most once in this many days
# CAREER_SITE_PAGES_PER_CRAWL=150          # new posting pages read on one site in one crawl
# CAREER_SITE_PAGES_PER_DAY=2000           # new posting pages read on all sites together in 24 hours
# CAREER_SITE_REQUEST_GAP_SECONDS=1        # pause between two requests to one host (never less than 1; a longer Crawl-delay wins)
# CAREER_SITE_SITEMAPS_PER_CRAWL=12        # sitemap files read on one site in one crawl
# CAREER_SITE_BROWSER_PAGES=4              # pages rendered in the headless browser on one site in one crawl (0 = never)
# CAREER_SITE_CONCURRENCY=2                # sites crawled at the same time
# CAREER_SITE_CRAWL_SECONDS=1200           # one crawl stops reading new pages after this long
# CAREER_SITE_MAX_BACKOFF_DAYS=90          # a site that fails, is not readable or has no US postings waits longer each time, never longer than this
#
# The values for 50 results or fewer grow with the request (MAX_AI_RANKED_JOBS and the per-stage caps linearly, a round of
# AI web search up to twice). The ceilings below are SAFETY limits of one whole search, far above what a normal search
# uses, so that a search can never spend without end; they are not there to save money.
# AI_BUDGET_SCALING=true                   # false: every search makes one round's AI web-search calls and no more
# OPENAI_SEARCH_CALLS_MAX=96               # calls on ATS hosts of one whole search (all rounds), per provider
# CLAUDE_SEARCH_CALLS_MAX=96
# OPENAI_OPEN_WEB_CALLS_MAX=48             # calls on employers' own sites of one whole search
# CLAUDE_OPEN_WEB_CALLS_MAX=96
# AI_WEB_SEARCHES_PER_CALL_MAX=10          # live web searches inside one call on ATS hosts
# MAX_AI_CALLS_PER_SEARCH_MAX=1000         # every OpenAI / Claude call of one search together (hard stop); the web search
#                                          # always leaves the calls the judging of the result list needs
# MAX_AI_RANKED_JOBS_MAX=400               # jobs judged by OpenAI / Claude (40 % of the request within this ceiling)
# MAX_PAGE_VERIFICATIONS_MAX=2400          # page leads of one whole search
# MAX_DETAIL_FETCHES_MAX=1000
# MAX_AUDIT_JOBS_MAX=200
# MAX_BOARDS_PER_SEARCH_MAX=6000
# MAX_INDEX_CANDIDATES=6000                # postings of one search loaded for screening; about 60 MB per 1,000. Larger machine: 20000
#
# Rounds: a search keeps going until the requested number of verified jobs (at or above the minimum match score by
# keyword score) is reached. Otherwise it stops only when SEARCH_STALE_ROUNDS rounds in a row add no new such job,
# when every discovery budget of the search (or month, for SerpApi) is used up, at the time ceiling, or when cancelled.
# The reason is stored with the run and shown in the progress window.
# SEARCH_STALE_ROUNDS=2
# SEARCH_MAX_SECONDS=10800                 # wall-clock ceiling of one candidate search (3 hours): no new round starts after it
# SEARCH_BUDGET_ROUNDS=4                   # the search-wide discovery budgets are handed out over this many rounds
# SEARCH_MAX_ROUNDS=12                     # safety ceiling; 1 = a single pass, as before
# WORKER_JOB_TIMEOUT_SECONDS=14400         # the worker's limit for one whole run (all candidates); was one hour
# ROUND_FETCH_DEADLINE_SECONDS=60          # how long a round waits for newly found boards to be read
#
# --- Paid sources (used from round 2 on: only when the free sources left the search short) ---
# SerpApi, Google Jobs. The owner's key is read from the name serpapi_KEY (SERPAPI_API_KEY works too).
# Free plan: 250 searches per month. Every call not answered from the app's own cache is counted per calendar
# month, the account endpoint (free) is read every 5 minutes, and a search says so when SerpApi was skipped.
serpapi_KEY=
# SERPAPI_MAX_CALLS_PER_SEARCH=8           # result pages (10 jobs each) per candidate search. 250 a month = about 28 searches at 8
# SERPAPI_MONTHLY_LIMIT=250                # the plan's allowance, used when the account endpoint cannot be read
# SERPAPI_MONTHLY_RESERVE=25               # kept back so the last searches of the month still get some
# SERPAPI_PAGES_PER_QUERY=3
# SERPAPI_CACHE_HOURS=6
# SERPAPI_INCLUDE_LISTED_ONLY=true         # false: drop jobs that only have job-board links (they are stored as "Not verified")
# AGGREGATOR_HOSTS=linkedin.com,indeed.com,glassdoor.com,ziprecruiter.com,simplyhired.com,dice.com,talent.com,...   # never fetched
# TinyFish: TinySearch (second discovery engine) and TinyFetch (pages our browser could not render). Agent, Research,
# Browser and vault endpoints are never used.
tinyfish_api_key=
# TINYFISH_SEARCH_QUERIES_PER_SEARCH=40    # 0.005 USD each; the open-web queries of the first round count here too
# TINYFISH_FETCHES_PER_SEARCH=10           # 0.001 USD each
# TINYFISH_DAILY_USD=5.0                   # safety ceiling per UTC day, computed from the two prices
# TINYFISH_WALLET_RESERVE_USD=2.0          # TinyFish is not used when the wallet balance is below this
# TINYFISH_SEARCH_USD=0.005
# TINYFISH_FETCH_USD=0.001
#
# --- AWS Bedrock AgentCore Web Search (every search from round 1, plus POST /api/web-search/jobs for managers) ---
# Credentials: boto3's default chain (on EC2 the instance profile via IMDSv2); never put keys here. The role needs
# bedrock-agentcore:InvokeWebSearch on arn:aws:bedrock-agentcore:us-east-1:aws:tool/web-search.v1.
# Result text is never stored; only employer postings verified on the employer's own feed are kept.
# AWS_WEB_SEARCH_ENABLED=false
# AWS_WEB_SEARCH_REGION=us-east-1
# AWS_WEB_SEARCH_ID=web-search.v1
# AWS_WEB_SEARCH_MONTHLY_LIMIT=4000         # queries per calendar month (UTC), counted in PostgreSQL before every attempt
# AWS_WEB_SEARCH_MONTHLY_RESERVE=300        # kept for the managers' endpoint: background searches stop at limit - reserve
# AWS_WEB_SEARCH_MAX_CALLS_PER_SEARCH=12    # per candidate search (50 results), all in the first round; scaled up to ..._MAX
# AWS_WEB_SEARCH_MAX_CALLS_PER_SEARCH_MAX=30
# AWS_WEB_SEARCH_OPEN_WEB_SHARE=0.5         # share of those queries that ask "any site" for postings on employers' own sites
#                                           # (job boards, unreadable platforms and the ATS hosts excluded; newest results first)
#                                           # instead of one ATS host; none under an ATS platform filter
# AWS_WEB_SEARCH_EXPECTED_SEARCHES_PER_DAY=45   # pacing: candidate searches per working day. The month's allowance is a hard
#                                           # quota: a search gets remaining / (this x working days left), at most the cap above
#                                           # (about 4 a search at the start of a month, 12 once the month runs under this pace)
# AWS_WEB_SEARCH_MAX_RESULTS=25             # 1-25 (API maximum)
# AWS_WEB_SEARCH_PUBLISHED_DAYS=0       # 0 = no date filter (with the filter, job-board queries returned nothing)
# AWS_WEB_SEARCH_MAX_ATTEMPTS=3             # per query on throttling / 5xx / timeout; every attempt counts
# AWS_WEB_SEARCH_CONNECT_TIMEOUT_SECONDS=5
# AWS_WEB_SEARCH_READ_TIMEOUT_SECONDS=20
# AWS_WEB_SEARCH_USER_PER_MINUTE=3          # endpoint requests per user
# AWS_WEB_SEARCH_USER_PER_DAY=40
# AWS_WEB_SEARCH_ENDPOINT_MAX_CALLS=6       # queries per endpoint request
# AWS_WEB_SEARCH_ENDPOINT_TIMEOUT_SECONDS=75

# --- Salesforce (read-only) ---
# Candidates are searched in Salesforce and brought into the portal; the portal never writes to Salesforce.
# Sign-in is the OAuth JWT bearer flow (RS256) of a connected app. Leave all four empty to switch the integration off.
# Consumer key of the connected app
SF_CLIENT_ID=
# User name of the integration user (give it a read-only profile)
SF_USERNAME=
# https://login.salesforce.com (production), https://test.salesforce.com (sandbox) or the org's My Domain URL
SF_LOGIN_URL=
# The connected app's RSA private key (PEM file), base64 on one line:  base64 -w0 private.pem
# SF_PRIVATE_KEY_B64 is read as well and wins when both are set.
PRIVATE_KEY_B64=
# SALESFORCE_SEARCHES_PER_MINUTE=60   # per signed-in user

# --- Performance and logs ---
# Team and organisation analytics are cached in Redis and retired on every committed change. 0 turns the cache off.
ANALYTICS_CACHE_SECONDS=60
# json (one object per line) or text
LOG_FORMAT=json
LOG_LEVEL=INFO

# AI auto-apply (Admin only; docs/auto-apply-api.md). Off by default. Nothing is ever submitted without an Admin
# approval of the exact preview; CAPTCHAs, sign-ins and bot checks are never worked around (the run is handed back).
# AUTO_APPLY_ENABLED=false
# AUTO_APPLY_BROWSER_CONCURRENCY=1        # application browsers at the same time (1 on a 4 GB server)
# AUTO_APPLY_EMPLOYER_DAILY_CAP=5         # submissions per employer per 24 h across all candidates
# AUTO_APPLY_RUN_TIMEOUT_SECONDS=240
# AUTO_APPLY_HOST_INTERVAL_SECONDS=20     # pacing between two form openings on the same employer
# AUTO_APPLY_SCREENSHOT_RETENTION_DAYS=14
# AUTO_APPLY_SCREENSHOT_MAX_BYTES=600000
# AUTO_APPLY_MAX_RUNS_PER_REQUEST=20
# AUTO_APPLY_RESPECT_ROBOTS=true
# AUTO_APPLY_AI_CLASSIFY=true             # unknown question labels: techsara-35b first, then OpenAI / Claude
# AUTO_APPLY_DRAFT_PROVIDER=openai,claude  # free-text drafting order

# The company model's own web search tool (POST /v1/responses, tools: web_search) as one more search engine for
# employer job boards. Needs TECHSARA_API_KEY. Only result addresses are used; every address is checked.
# It never repeats a query another search engine sent in the same job search: beside SearXNG it asks the queries
# SearXNG will not reach (and once more those SearXNG failed on or got nothing for); without SearXNG it takes its place.
# TECHSARA_WEB_SEARCH_ENABLED=true
# TECHSARA_WEB_SEARCHES_PER_SEARCH=40      # hard ceiling per job search
# TECHSARA_WEB_SEARCHES_BASE=12            # for 50 results or fewer; larger requests scale up to the ceiling
# TECHSARA_WEB_SEARCH_CONCURRENCY=2        # searches sent to the model at the same time (its queue is shared with the chat app)
# TECHSARA_WEB_SEARCH_TIMEOUT_SECONDS=60

# Ranking stage (docs/job-search-performance-phase2.md). A model's judgement of the same candidate and the same posting
# text is reused for RANK_CACHE_DAYS (0 = never); the reranker and the OpenAI / Claude judges each have a time limit
# per search, after which the jobs they did not reach keep the score they have.
# RANK_CACHE_DAYS=7
# TECHSARA_RERANK_SECONDS=90
# AI_RANK_SECONDS=150
